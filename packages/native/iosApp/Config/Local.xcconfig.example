// Copy to Local.xcconfig (ignored by Git) and fill in your own values.

// Apple developer team used for signing device builds.
DEVELOPMENT_TEAM = ABCDE12345

// Default App address for new invites. HTTPS origin only: no path or trailing slash.
// xcconfig treats // as a comment, so write the slashes as /$()/.
MESHBOARD_APP_ORIGIN = https:/$()/board.example.com
