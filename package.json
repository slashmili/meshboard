{
  "name": "meshboard",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @meshboard/web dev",
    "build": "pnpm check && pnpm --filter @meshboard/web build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @meshboard/web test:e2e",
    "turn": "node scripts/turn.mjs",
    "signaling": "pnpm --filter @meshboard/signaling start",
    "native": "./packages/native/gradlew -p packages/native run",
    "android": "node scripts/android.mjs run",
    "build:android": "node scripts/android.mjs build",
    "test:android": "node scripts/android.mjs test",
    "test:interop:android": "node scripts/android.mjs interop",
    "test:native": "./packages/native/gradlew -p packages/native desktopTest",
    "test:interop": "./packages/native/gradlew -p packages/native prepareInterop && pnpm --filter @meshboard/web exec playwright test -c playwright.native.config.ts"
  }
}
