# Only server/web build inputs may enter the image context. In particular, no
# .env, Git history, native toolchains, private keys, or local build products.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/
packages/*
!packages/web/
packages/web/*
!packages/web/package.json
!packages/web/tsconfig.json
!packages/web/vite.config.ts
!packages/web/index.html
!packages/web/src/
!packages/web/src/**
!packages/signaling/
packages/signaling/*
!packages/signaling/package.json
!packages/signaling/tsconfig.json
!packages/signaling/src/
!packages/signaling/src/**
!packages/shared-protocol/
packages/shared-protocol/*
!packages/shared-protocol/package.json
!packages/shared-protocol/tsconfig.json
!packages/shared-protocol/src/
!packages/shared-protocol/src/**
!packages/shared-protocol/fixtures/
!packages/shared-protocol/fixtures/**
!icons/
icons/*
!icons/meshboard-icon.svg
!icons/meshboard-mark.svg
!icons/meshboard-icon-1024.png
!infra/
infra/*
!infra/deploy/
infra/deploy/*
!infra/deploy/Dockerfile
!infra/deploy/Caddyfile
**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
