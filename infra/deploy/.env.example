# Copy to infra/deploy/.env (ignored by Git). No values here are site-specific.
APP_DOMAIN=board.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=admin@example.com

# Public IPv4 actually assigned to a server interface; NAT is not supported by
# this first deployment template. Do not put a DNS name here.
TURN_PUBLIC_IP=203.0.113.10

# Generate locally with: openssl rand -hex 32
# Shared only between signaling and Coturn. Never send it to clients or commit it.
TURN_SECRET=

# Single public IP: HTTPS :443, TURN UDP/TCP :3478, TURN/TLS :5349.
WEB_BIND_IP=0.0.0.0
TURN_TLS_PORT=5349
# With TWO assigned public IPs, set WEB_BIND_IP to the web IP, TURN_PUBLIC_IP to
# the other IP, TURN_TLS_PORT=443, and point each DNS name at the respective IP.

TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_TOTAL_QUOTA=100
# Bytes/second, not bits/second. These cap relay capacity, not provider billing.
TURN_MAX_BPS=1000000
TURN_BPS_CAPACITY=20000000

# Clients currently fetch once per session. Rejoin after this lifetime expires.
TURN_TTL_SECONDS=86400
# Temporarily enable for acceptance testing, then disable and refresh clients.
MESHBOARD_RELAY_ONLY=false

COMPOSE_PROJECT_NAME=meshboard
MESHBOARD_IMAGE_PREFIX=meshboard
MESHBOARD_IMAGE_TAG=local
