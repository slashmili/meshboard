# Root .env is read by the Vite dev/preview server. Restart after changing it.
# Without overrides, local development uses the relay launched by pnpm turn.
# Never put board encryption secrets in environment variables or VITE_* values.

# MESHBOARD_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349?transport=tcp
# MESHBOARD_TURN_USERNAME=replace-with-turn-username
# MESHBOARD_TURN_CREDENTIAL=replace-with-turn-credential

# Alternative for a public Coturn server using use-auth-secret. Do not combine
# with USERNAME/CREDENTIAL. Clients receive expiring HMAC credentials, not this key.
# MESHBOARD_TURN_SECRET=generate-with-openssl-rand-hex-32
# MESHBOARD_TURN_TTL_SECONDS=86400
# For Docker Compose use infra/deploy/.env.example instead; see docs/deployment.md.

# Force relay candidates for a manual TURN check; default is false.
# MESHBOARD_RELAY_ONLY=true

# Standalone signaling only; explicitly opt into loopback development settings.
# MESHBOARD_LOCAL_DEV=true
